DATABASE_URL=sqlite:///./loyalty.db
# For a real deployment, point at a Postgres DSN instead (Railway/Heroku-style
# `postgres://` and bare `postgresql://` DSNs are both auto-normalized to
# `postgresql+psycopg2://` at startup -- see app/config.py):
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/railway

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Per-merchant Shopify webhook secrets are stored on the Merchant row
# (Merchant.shopify_webhook_secret), not as a global env var -- the seed
# script sets a demo value for the demo merchant. No SHOPIFY_* env var is
# required to run the app; this is just documenting where the secret lives.

# Stripe billing (PLAN_BATCH3.md §2). All optional -- the app runs fine with
# none of these set; billing endpoints return 503 "billing not configured"
# instead of crashing. Fill in with test-mode keys from a free Stripe
# account (Developers > API keys) to exercise checkout/portal/webhooks
# locally; STRIPE_WEBHOOK_SECRET comes from `stripe listen --print-secret`
# (Stripe CLI) or the webhook endpoint's settings page once deployed.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_STARTER=price_...
# STRIPE_PRICE_ID_GROWTH=price_...
# STRIPE_PRICE_ID_SCALE=price_...
# BILLING_SUCCESS_URL=http://localhost:5173/billing/success
# BILLING_CANCEL_URL=http://localhost:5173/billing/cancel
